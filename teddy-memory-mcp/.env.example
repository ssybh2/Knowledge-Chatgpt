# Backend secret used by the MCP server to call Teddy Memory REST API.
# Required for stdio and remote deployments. Never commit the real value.
MEMORY_API_KEY=

# Remote MCP client credential. Required only for the private Streamable HTTP deployment.
# Keep it different from MEMORY_API_KEY. Never commit the real value.
MCP_ACCESS_TOKEN=

# Backend REST API.
TEDDY_MEMORY_API_BASE_URL=https://teddy-memory-api.3767174214.workers.dev

# Backend request timeout in milliseconds.
TEDDY_MEMORY_TIMEOUT_MS=15000

# Explicit remote host allowlist for Streamable HTTP.
MCP_ALLOWED_HOSTS=teddy-memory-mcp.3767174214.workers.dev

# Optional comma-separated Origin hostnames. Server-to-server MCP clients normally omit Origin.
MCP_ALLOWED_ORIGINS=
